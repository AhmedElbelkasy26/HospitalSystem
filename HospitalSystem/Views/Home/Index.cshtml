@model HospitalSystem.Models.DashboardViewModel

<h2>Dashboard</h2>
<p class="text-muted">DashboardController / Index</p>

<div class="row mb-4">
    <div class="col-md-3"><div class="card p-3 shadow-sm"><span class="text-muted">Patients Today</span><h2>@Model.PatientsToday</h2></div></div>
    <div class="col-md-3"><div class="card p-3 shadow-sm"><span class="text-muted">Appointments</span><h2>@Model.AppointmentsToday</h2></div></div>
    <div class="col-md-3"><div class="card p-3 shadow-sm"><span class="text-muted">Free Beds</span><h2>@Model.FreeBeds</h2></div></div>
    <div class="col-md-3"><div class="card p-3 shadow-sm"><span class="text-muted">Unpaid Invoices</span><h2>@Model.UnpaidInvoices</h2></div></div>
</div>

<h4>Today's Appointments</h4>
<table class="table table-striped">
    <thead>
        <tr><th>Time</th><th>Patient</th><th>Doctor</th><th>Department</th><th>Status</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.TodaysAppointments)
        {
            <tr>
                <td>@item.time</td>
                <td>@item.Patient?.name</td>
                <td>@item.Doctor?.name</td>
                <td>@item.Doctor?.Department?.name</td>
                <td><span class="badge bg-primary">@item.note</span></td>
            </tr>
        }
    </tbody>
</table>