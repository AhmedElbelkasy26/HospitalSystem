@model HospitalManagementSystem.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="container py-4">

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h2 class="fw-bold text-danger mb-3">
                Delete Appointment
            </h2>

            <div class="alert alert-warning">
                Are you sure you want to delete this appointment?
                This action cannot be undone.
            </div>

            <dl class="row">

                <dt class="col-sm-3">Patient</dt>
                <dd class="col-sm-9">
                    @(Model.Patient?.name ?? "N/A")
                </dd>

                <dt class="col-sm-3">Doctor</dt>
                <dd class="col-sm-9">
                    @(Model.Doctor?.name ?? "N/A")
                </dd>

                <dt class="col-sm-3">Department</dt>
                <dd class="col-sm-9">
                    @(Model.Doctor?.Department?.name ?? "N/A")
                </dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">
                    @Model.date.ToString("dd/MM/yyyy")
                </dd>

                <dt class="col-sm-3">Time</dt>
                <dd class="col-sm-9">
                    @Model.time.ToString(@"hh\:mm")
                </dd>

            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.id"
                  method="post">

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
